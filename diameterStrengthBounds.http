@server = http://localhost
@port = 3000
@api_path = api
@api_version = 1
@url = {{server}}:{{port}}/{{api_path}}/v{{api_version}}

###############################################

// Test: Get all diameterStrengthBounds
// Expected HTTP response status code: 200
// Expected response: an array (json) with all diameterStrengthBounds
// [{}, {}, ...]
GET {{url}}/lenses/diameters

###############################################

// Test: Get a diameter strength bound (dsb) that exists, the dsb have a composite ID
// so to get the correct dsb we need to add both the type and quality.
// Expected HTTP response status code: 200
// Expected response: a dsb object (json)
GET {{url}}/lenses/diameters/Progressiva/7
